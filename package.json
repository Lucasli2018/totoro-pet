{
  "name": "totoro-pet",
  "version": "0.1.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "pet",
    "totoro"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node tests/smoke-client.mjs",
    "link": "dsh plugin --profile web add link:.",
    "unlink": "dsh plugin --profile web remove totoro-pet"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
